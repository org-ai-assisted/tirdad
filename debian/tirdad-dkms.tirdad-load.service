[Unit]
Description=Load tirdad kernel module (TCP ISN randomization)
Documentation=https://www.kicksecure.com/wiki/Tirdad

## tirdad is loaded here rather than via /usr/lib/modules-load.d/, which runs
## through the strict systemd-modules-load.service: a single module there that
## fails to load fails the whole service and marks the system degraded. Under
## Secure Boot the unsigned out-of-tree tirdad module is rejected ("Key was
## rejected by service") unless the DKMS MOK is enrolled, and that must not
## degrade the system.

DefaultDependencies=no
After=systemd-modules-load.service
## Load before the network comes up so TCP ISN randomization covers the first
## connections. All network units (networking.service, systemd-networkd.service,
## ifup@.service) are ordered After=systemd-sysctl.service, so ordering before it
## places tirdad ahead of them -- the old modules-load.d entry loaded inside
## systemd-modules-load.service, which was likewise before networking.
Before=systemd-sysctl.service
## Load before security-misc locks down kernel module loading.
Before=harden-module-loading.service
## Load before LKRG baselines the kernel, or LKRG sees tirdad's livepatch as
## tampering and panics. (The module no longer loads via modules-load.d, so file
## ordering no longer guarantees this.)
Before=lkrg.service
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
## The leading "-" makes a failed modprobe (e.g. Secure Boot rejection)
## non-fatal: the unit stays successful, so the system is not marked degraded.
## The load is still attempted on every boot, so tirdad loads normally, and
## under Secure Boot when the DKMS MOK is enrolled.
##
## "-" tolerates ANY load failure, not only Secure Boot rejection. That is
## deliberate: the purpose is to keep the whole system from going degraded on
## tirdad's account. A load failure is NOT concealed -- systemcheck's
## check_tirdad_module reports tirdad as absent and, when Secure Boot is OFF,
## treats it as a critical issue (non-zero exit), which the release gate's
## systemcheck run turns red. So the per-module health signal lives in
## systemcheck, and this unit only governs systemd's degraded state.
##
## --use-blacklist honors an administrator "blacklist tirdad" in modprobe.d (an
## explicit modprobe ignores the blacklist without it); that is the supported
## opt-out for disabling tirdad.
ExecStart=-/sbin/modprobe --use-blacklist tirdad

[Install]
WantedBy=sysinit.target
